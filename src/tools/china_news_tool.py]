"""Chinese financial news aggregation tool for A-share stocks."""

from dataclasses import dataclass
from typing import Any

import akshare as ak
from src.tools.investment_memory import InvestmentMemory


@dataclass
class ChinaNewsArticle:
    title: str
    source: str | None
    date: str | None
    snippet: str | None
    url: str | None
    platform: str

    def to_dict(self) -> dict[str, Any]:
        return self.__dict__


class ChinaNewsTool:
    """Aggregate Chinese financial news from multiple sources."""

    def __init__(self) -> None:
        self._memory = InvestmentMemory()

    def _pure_symbol(self, symbol: str) -> str:
        return symbol.lower().replace("sh", "").replace("sz", "").replace("bj", "")

    def _dedupe(self, articles: list[ChinaNewsArticle]) -> list[ChinaNewsArticle]:
        seen = set()
        result = []

        for article in articles:
            key = article.title.strip()
            if not key or key in seen:
                continue
            seen.add(key)
            result.append(article)

        return result

    def _eastmoney_stock_news(self, symbol: str, limit: int) -> list[ChinaNewsArticle]:
        pure = self._pure_symbol(symbol)
        df = ak.stock_news_em(symbol=pure)

        articles = []
        for _, row in df.head(limit).iterrows():
            articles.append(
                ChinaNewsArticle(
                    title=str(row.get("新闻标题", "")),
                    source=str(row.get("文章来源", "")),
                    date=str(row.get("发布时间", "")),
                    snippet=str(row.get("新闻内容", "")),
                    url=str(row.get("新闻链接", "")),
                    platform="东方财富",
                )
            )
        return articles

    def _cctv_macro_news(self, limit: int) -> list[ChinaNewsArticle]:
        df = ak.news_cctv()

        articles = []
        for _, row in df.head(limit).iterrows():
            articles.append(
                ChinaNewsArticle(
                    title=str(row.get("title", "")),
                    source="央视新闻",
                    date=str(row.get("date", "")),
                    snippet=str(row.get("content", "")),
                    url=None,
                    platform="央视新闻",
                )
            )
        return articles


    def _cls_global_news(self, symbol: str, limit: int) -> list[ChinaNewsArticle]:
        df = ak.stock_info_global_cls()

        articles = []
        for _, row in df.head(limit).iterrows():
            title = str(row.get("标题", "")).strip()
            content = str(row.get("内容", "")).strip()
            if not title and not content:
                continue

            articles.append(
                ChinaNewsArticle(
                    title=title or content[:50],
                    source="财联社",
                    date=f"{row.get('发布日期', '')} {row.get('发布时间', '')}",
                    snippet=content,
                    url=None,
                    platform="财联社",
                )
            )
        return articles

    def get_stock_news(self, symbol: str, limit: int = 10) -> list[ChinaNewsArticle]:
        articles: list[ChinaNewsArticle] = []

        sources = [
            self._eastmoney_stock_news,
            self._cls_global_news,
        ]

        for source in sources:
            try:
                articles.extend(source(symbol, limit))
            except Exception:
                pass

        articles = self._dedupe(articles)

        fresh_articles = []
        for article in articles:
            if not self._memory.is_news_seen(article.title, article.url):
                fresh_articles.append(article)

        for article in fresh_articles:
            self._memory.mark_news_seen(symbol, article.to_dict())

        return fresh_articles[:limit]

    def get_market_news(self, limit: int = 10) -> list[ChinaNewsArticle]:
        articles: list[ChinaNewsArticle] = []

        sources = [
            self._cctv_macro_news,
        ]

        for source in sources:
            try:
                articles.extend(source(limit))
            except Exception:
                pass

        articles = self._dedupe(articles)

        fresh_articles = []
        for article in articles:
            if not self._memory.is_news_seen(article.title, article.url):
                fresh_articles.append(article)

        for article in fresh_articles:
            self._memory.mark_news_seen(symbol, article.to_dict())

        return fresh_articles[:limit]
